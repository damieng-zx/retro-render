{
  "compilerOptions": {
    "module": "system",
    "target": "es6",
    "lib": ["es2020", "dom"],
    "outFile": "dist/combined.js",
    "sourceMap": true,
    "rootDir": "src",
    "declaration": true,
    "removeComments": true,
    "strict": true,
    "noImplicitReturns": true,
    "types": []
  },
  "exclude": ["node_modules", "dist"],
  "compileOnSave": true
}
